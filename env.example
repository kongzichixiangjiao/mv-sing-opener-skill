# 复制为 .env 后填写；.env 已在 .gitignore 中，不会进 Git。
# 所有 key / 本地地址都放这里，不要写进 config.json 或代码。

# 图片生成接口（可选；不填就跳过 AI 生图）
NEWAPI_IMAGE_BASE_URL=https://your-image-api.example.com
NEWAPI_IMAGE_KEY=
NEWAPI_IMAGE_MODEL=gpt-image-2-c
NEWAPI_IMAGE_QUALITY=high

# 素材公网根与本地目录（必须指向同一处）
ASSET_URL_BASE=https://your-static-host.example.com/public/mv
ASSET_DEST_DIR=/var/www/public/mv

# 视频生成网关
VIDEO_GATEWAY_BASE=http://127.0.0.1:4000
VIDEO_API_PREFIX=/v1
VIDEO_MODEL=doubao-seedance-2-5-260628
